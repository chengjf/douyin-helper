{
  "manifest_version": 3,
  "name": "Douyin Helper",
  "version": "1.0.1",
  "description": "抖音创作者中心助手",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://creator.douyin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://creator.douyin.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject/index.js"],
      "matches": ["https://creator.douyin.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Douyin Helper"
  }
}
